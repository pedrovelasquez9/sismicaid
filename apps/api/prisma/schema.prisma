// Esquema de datos — fuente: docs/DATABASE.md y docs/SPEC.md §6.
// Los `enum` deben coincidir literalmente con packages/shared/src/enums.ts
// (verificado por src/schema.test.ts). Columnas en snake_case vía @map.

generator client {
  provider = "prisma-client-js"
  // Output explícito: pnpm no resuelve de forma fiable el cliente generado en
  // node_modules/.prisma; lo emitimos dentro del paquete. (gitignored)
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum TrustLevel {
  official
  verified
  community_pending
  outdated
  rejected
}

enum SourceType {
  seismic
  tsunami
  civil_protection
  media
  manual
}

enum SourceStatus {
  active
  degraded
  disabled
}

enum SeismicStatus {
  automatic
  reviewed
  deleted
}

enum EventType {
  earthquake
  quarry_blast
  other
}

enum AlertLevel {
  green
  yellow
  orange
  red
  unknown
}

enum TsunamiProvider {
  NOAA_PTWC
  NOAA_NTWC
  LOCAL_AUTHORITY
}

enum TsunamiStatus {
  information
  watch
  advisory
  warning
  canceled
  unknown
}

enum CoastalRiskLevel {
  none
  info
  watch
  warning
  canceled
}

enum ResourceType {
  shelter
  hospital
  collection_center
  water
  food
  charging_point
  communication
  transport
  volunteer_center
}

enum ResourceStatus {
  active
  saturated
  closed
  unknown
}

enum CapacityStatus {
  available
  limited
  full
  unknown
}

enum LocationPrecision {
  exact
  approximate
  area
}

enum VerificationStatus {
  pending
  verified
  rejected
  outdated
}

enum Urgency {
  low
  medium
  high
  critical
}

enum NeedStatus {
  open
  in_progress
  partially_covered
  covered
  outdated
}

enum ReportType {
  structural_damage
  blocked_road
  landslide
  trapped_person
  urgent_need
  available_resource
  active_shelter
  collection_center
  operational_hospital
  electrical_risk
  gas_leak
  no_signal_zone
  no_water_zone
  no_power_zone
}

enum ReportSourceType {
  first_hand
  reported_by_other
  media
  authority
  volunteer
}

enum ReportVerificationStatus {
  pending
  in_review
  verified
  rejected
  duplicate
  outdated
}

enum RecommendationContext {
  earthquake_before
  earthquake_during
  earthquake_after
  tsunami
  coast
  damaged_building
  communications
}

enum FetchStatus {
  success
  partial
  failed
}

// ---------- Modelos ----------

model OfficialSource {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique
  type          SourceType
  country       String?
  baseUrl       String?      @map("base_url")
  status        SourceStatus @default(active)
  trustLevel    TrustLevel   @map("trust_level")
  lastCheckedAt DateTime?    @map("last_checked_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  seismicEvents SeismicEvent[]
  tsunamiAlerts TsunamiAlert[]
  resources     Resource[]
  needs         Need[]

  @@map("official_sources")
}

model SeismicEvent {
  id               String          @id @default(uuid()) @db.Uuid
  externalId       String          @map("external_id")
  sourceId         String?         @map("source_id") @db.Uuid
  source           OfficialSource? @relation(fields: [sourceId], references: [id])
  sourceName       String?         @map("source_name")
  status           SeismicStatus   @default(automatic)
  eventType        EventType       @default(earthquake) @map("event_type")
  place            String?
  country          String?
  latitude         Float
  longitude        Float
  depthKm          Float?          @map("depth_km")
  magnitude        Float?
  magnitudeType    String?         @map("magnitude_type")
  eventTimeUtc     DateTime        @map("event_time_utc")
  eventTimeLocal   DateTime?       @map("event_time_local")
  updatedAtSource  DateTime?       @map("updated_at_source")
  mmi              Float?
  cdi              Float?
  alertLevel       AlertLevel      @default(unknown) @map("alert_level")
  tsunamiFlag      Boolean         @default(false) @map("tsunami_flag")
  significance     Int?
  feltReportsCount Int?            @map("felt_reports_count")
  detailUrl        String?         @map("detail_url")
  rawPayload       Json?           @map("raw_payload")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tsunamiAlerts TsunamiAlert[]

  @@unique([sourceId, externalId])
  @@index([externalId])
  @@index([eventTimeUtc])
  @@index([magnitude])
  @@index([latitude, longitude])
  @@index([sourceId])
  @@index([tsunamiFlag])
  @@map("seismic_events")
}

model TsunamiAlert {
  id                    String          @id @default(uuid()) @db.Uuid
  externalId            String?         @unique @map("external_id")
  sourceId              String?         @map("source_id") @db.Uuid
  source                OfficialSource? @relation(fields: [sourceId], references: [id])
  provider              TsunamiProvider
  status                TsunamiStatus   @default(unknown)
  headline              String
  description           String?
  affectedAreaText      String?         @map("affected_area_text")
  effectiveAt           DateTime?       @map("effective_at")
  expiresAt             DateTime?       @map("expires_at")
  eventTimeUtc          DateTime?       @map("event_time_utc")
  relatedSeismicEventId String?         @map("related_seismic_event_id") @db.Uuid
  relatedSeismicEvent   SeismicEvent?   @relation(fields: [relatedSeismicEventId], references: [id])
  rawPayload            Json?           @map("raw_payload")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([effectiveAt])
  @@index([expiresAt])
  @@index([relatedSeismicEventId])
  @@map("tsunami_alerts")
}

model CoastalAlertZone {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @unique
  state            String
  municipality     String?
  coastlineGeojson Json?            @map("coastline_geojson")
  riskLevel        CoastalRiskLevel @default(none) @map("risk_level")
  lastAlertId      String?          @map("last_alert_id") @db.Uuid
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("coastal_alert_zones")
}

model Resource {
  id                 String             @id @default(uuid()) @db.Uuid
  type               ResourceType
  name               String
  state              String
  municipality       String?
  parish             String?
  latitude           Float?
  longitude          Float?
  locationPrecision  LocationPrecision  @default(approximate) @map("location_precision")
  status             ResourceStatus     @default(unknown)
  capacityStatus     CapacityStatus     @default(unknown) @map("capacity_status")
  description        String?
  publicContact      String?            @map("public_contact")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  sourceId           String?            @map("source_id") @db.Uuid
  source             OfficialSource?    @relation(fields: [sourceId], references: [id])
  createdBy          String?            @map("created_by")
  lastVerifiedAt     DateTime?          @map("last_verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  needs Need[]

  @@map("resources")
}

model Need {
  id                 String             @id @default(uuid()) @db.Uuid
  category           String
  title              String
  description        String?
  state              String
  municipality       String?
  parish             String?
  latitude           Float?
  longitude          Float?
  locationPrecision  LocationPrecision  @default(approximate) @map("location_precision")
  urgency            Urgency            @default(medium)
  quantity           String?
  status             NeedStatus         @default(open)
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  sourceId           String?            @map("source_id") @db.Uuid
  source             OfficialSource?    @relation(fields: [sourceId], references: [id])
  relatedResourceId  String?            @map("related_resource_id") @db.Uuid
  relatedResource    Resource?          @relation(fields: [relatedResourceId], references: [id])
  createdBy          String?            @map("created_by")
  lastVerifiedAt     DateTime?          @map("last_verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("needs")
}

model CitizenReport {
  id                 String                   @id @default(uuid()) @db.Uuid
  reportType         ReportType               @map("report_type")
  title              String
  description        String?
  state              String
  municipality       String?
  parish             String?
  latitude           Float?
  longitude          Float?
  locationPrecision  LocationPrecision        @default(approximate) @map("location_precision")
  urgency            Urgency                  @default(medium)
  evidenceUrl        String?                  @map("evidence_url")
  reportSourceType   ReportSourceType         @map("report_source_type")
  // Privado: nunca se expone en DTOs públicos (ver SECURITY_AND_PRIVACY.md).
  privateContact     String?                  @map("private_contact")
  publicSafeSummary  String?                  @map("public_safe_summary")
  verificationStatus ReportVerificationStatus @default(pending) @map("verification_status")
  moderatorNotes     String?                  @map("moderator_notes")
  // Marca cuándo se confirmó el rescate/cierre. NULL = activo. Spec rescate.
  resolvedAt         DateTime?                @map("resolved_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([verificationStatus])
  @@index([createdAt])
  @@map("citizen_reports")
}

model SafetyRecommendation {
  id        String                @id @default(uuid()) @db.Uuid
  context   RecommendationContext
  title     String
  body      String
  priority  Int                   @default(0)
  sourceId  String?               @map("source_id") @db.Uuid
  isActive  Boolean               @default(true) @map("is_active")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@map("safety_recommendations")
}

model FetchRun {
  id                  String      @id @default(uuid()) @db.Uuid
  sourceId            String?     @map("source_id") @db.Uuid
  jobName             String      @map("job_name")
  status              FetchStatus
  startedAt           DateTime    @default(now()) @map("started_at")
  finishedAt          DateTime?   @map("finished_at")
  itemsFound          Int         @default(0) @map("items_found")
  itemsCreated        Int         @default(0) @map("items_created")
  itemsUpdated        Int         @default(0) @map("items_updated")
  errorMessage        String?     @map("error_message")
  rawResponseSnapshot Json?       @map("raw_response_snapshot")

  @@index([sourceId])
  @@index([jobName])
  @@map("fetch_runs")
}

// ============================================================
// Sprint 1  Enterprise Foundation
// audit log, anti-abuse, push subscriptions, safety check, outbox
// Added: 2026-06-26
// ============================================================
model AuditLog {
  id           BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @db.Timestamptz(6)
  eventType    String   @db.VarChar(64) // p.ej. "report.created"
  actorType    String   @db.VarChar(32) // "anonymous" | "device" | "moderator" | "system"
  actorRef     String?  @db.VarChar(128) // device hash, system job name, etc. NUNCA PII directo
  resourceType String   @db.VarChar(32) // "report" | "aid" | "safety_check" | ...
  resourceId   String   @db.VarChar(64) // ULID o id externo
  payload      Json // payload canónico (claves ordenadas)
  prevHash     String   @db.Char(64) // hex sha256 del bloque anterior
  hash         String   @unique @db.Char(64) // hex sha256 de este bloque
  chainId      String   @default("default") @db.VarChar(32) // permite sellar chain y abrir nuevo

  @@index([resourceType, resourceId])
  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([chainId, id]) // recorrido secuencial
  @@map("audit_log")
}

model ReporterReputation {
  deviceKey          String    @id @db.Char(64) // sha256(salt || device_fingerprint)
  score              Int       @default(50) // 0–100
  reportsTotal       Int       @default(0)
  reportsVerified    Int       @default(0)
  reportsQuarantined Int       @default(0)
  firstSeenAt        DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt         DateTime  @default(now()) @db.Timestamptz(6)
  blockedAt          DateTime? @db.Timestamptz(6) // null = activo
  blockedReason      String?   @db.VarChar(256)

  @@index([score])
  @@index([blockedAt])
  @@map("reporter_reputation")
}

model DedupSignature {
  signature String   @id @db.Char(64)
  reportId  String   @db.VarChar(64)
  count     Int      @default(1)
  firstSeen DateTime @default(now()) @db.Timestamptz(6)
  lastSeen  DateTime @default(now()) @db.Timestamptz(6)

  @@index([reportId])
  @@index([lastSeen])
  @@map("dedup_signature")
}

model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique @db.Text // URL del push service (FCM/Mozilla/Apple)
  p256dh        String    @db.Text // clave pública del cliente
  auth          String    @db.Text // auth secret del cliente
  // Scope geográfico — qué áreas le interesan al usuario:
  geoScope      Json // { state?: string, h3_cells?: string[] }
  // Topics:
  topicSismos   Boolean   @default(true)
  topicTsunami  Boolean   @default(true)
  topicAyuda    Boolean   @default(false)
  // Higiene:
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastActiveAt  DateTime  @default(now()) @db.Timestamptz(6)
  failuresCount Int       @default(0) // tras N fallos consecutivos -> retirar
  retiredAt     DateTime? @db.Timestamptz(6)

  @@index([retiredAt])
  @@index([lastActiveAt])
  @@map("push_subscription")
}

model NotificationOutbox {
  id          BigInt    @id @default(autoincrement())
  channel     String    @db.VarChar(16) // "push" | "sms" | "webhook"
  payload     Json
  scopeKey    String    @db.VarChar(128) // ej. "state:caracas" o "subscriber:xyz"
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  pickedAt    DateTime? @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)
  failedAt    DateTime? @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  // Dedup: igual scope_key + payload_hash en ventana corta = mismo envío
  payloadHash String    @db.Char(64)

  @@index([deliveredAt, pickedAt]) // worker: pick non-delivered & non-picked
  @@index([scopeKey, payloadHash, createdAt]) // dedup
  @@map("notification_outbox")
}

model SafetyCheckCampaign {
  id              String    @id @default(cuid())
  triggerEventId  String    @db.VarChar(64) // referencia al evento USGS
  startedAt       DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime  @db.Timestamptz(6) // típicamente +72h
  // Área de impacto donde se solicita check:
  affectedH3Cells String[] // celdas H3 r6 afectadas
  closedAt        DateTime? @db.Timestamptz(6)

  responses SafetyCheckResponse[]

  @@index([startedAt])
  @@map("safety_check_campaign")
}

model SafetyCheckResponse {
  id            String              @id @default(cuid())
  campaignId    String
  campaign      SafetyCheckCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deviceKey     String              @db.Char(64) // anónimo, mismo que reputation
  status        String              @db.VarChar(16) // "safe" | "need_help"
  // Ubicación aprox del responder (k-anonymity garantizado al agregar):
  h3Cell        String              @db.VarChar(16) // r9 (~150m)
  // Triage médico opcional para need_help (START):
  triageColor   String?             @db.VarChar(8) // "red" | "yellow" | "green" | "black"
  notesRedacted String?             @db.VarChar(280) // texto libre limitado, sin PII según política
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime            @db.Timestamptz(6)

  @@unique([campaignId, deviceKey]) // una respuesta por device por campaign
  @@index([campaignId, status])
  @@index([h3Cell, campaignId])
  @@map("safety_check_response")
}
