{
  "name": "@sismicaid/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(api) no lint configured\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "seed:sources": "tsx prisma/seed-sources.ts",
    "seed:coastal-zones": "tsx prisma/seed-coastal-zones.ts",
    "seed:recommendations": "tsx prisma/seed-recommendations.ts",
    "fetch:usgs": "tsx src/jobs/fetch-usgs.ts",
    "fetch:ptwc": "tsx src/jobs/fetch-ptwc.ts",
    "fetch:venezuelatebusca": "tsx src/jobs/fetch-venezuelatebusca.ts",
    "fetch:encuentralos": "tsx src/jobs/fetch-encuentralos.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@sismicaid/shared": "workspace:*",
    "@prisma/client": "^5.18.0",
    "fast-xml-parser": "^4.4.1",
    "fastify": "^4.28.1",
    "tsx": "^4.16.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "prisma": "^5.18.0",
    "typescript": "^5.5.4"
  }
}
