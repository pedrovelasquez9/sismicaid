---
import Base from "../layouts/Base.astro";
import PersonSearch from "../components/PersonSearch.svelte";
---

<Base title="Buscar personas · SismicAid">
  <main>
    <header>
      <h1>Buscar personas</h1>
      <p class="lead">
        Busca por nombre en registros comunitarios públicos de personas desaparecidas tras el terremoto. Cada resultado
        enlaza a su fuente original y no está verificado.
      </p>
    </header>
    <PersonSearch client:load />
  </main>
</Base>

<style>
  main {
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-8);
  }
  header {
    margin-bottom: var(--space-5);
  }
  h1 {
    font-size: var(--font-2xl);
    margin: 0 0 var(--space-1);
  }
  .lead {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
